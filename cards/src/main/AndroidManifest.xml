<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="true" />
    <!-- «Activar móvil por NFC»: this phone emulates a card (HCE) for the AVO app of the phone put against it -->
    <uses-feature android:name="android.hardware.nfc.hce" android:required="false" />
    <application
        android:allowBackup="false"
        android:label="AVO Tarjetas"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Avo">
        <activity android:name=".CardsActivity" android:exported="true" android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".AvoHceService"
            android:exported="true"
            android:permission="android.permission.BIND_NFC_SERVICE">
            <intent-filter>
                <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
            </intent-filter>
            <meta-data android:name="android.nfc.cardemulation.host_apdu_service" android:resource="@xml/avo_hce_service" />
        </service>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="org.avoperformance.cards.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/license_files" />
        </provider>
    </application>
</manifest>
