(version 1)
# Reglas de AISLER para 4 capas, cobre de 35 µm, ENIG (0,8 y 1,6 mm):
# https://community.aisler.net/t/4-layer-35-m-enig-design-rules/3733 (consultado el 2026-10-29).
# Solo para comprobar la placa con el DRC de KiCad; no cambian el diseño.

(rule "AISLER ancho de pista mín. 125 µm"
	(constraint track_width (min 0.125mm)))

(rule "AISLER separación de cobre mín. 125 µm"
	(constraint clearance (min 0.125mm)))

(rule "AISLER cobre al borde mín. 300 µm"
	(constraint edge_clearance (min 0.3mm)))

(rule "AISLER taladro a taladro mín. 300 µm"
	(constraint hole_to_hole (min 0.3mm)))

(rule "AISLER vía: taladro 0,25–0,45 mm"
	(condition "A.Type == 'Via'")
	(constraint hole_size (min 0.25mm) (max 0.45mm)))

(rule "AISLER vía: anillo mín. 100 µm"
	(condition "A.Type == 'Via'")
	(constraint annular_width (min 0.1mm)))

(rule "AISLER PTH: taladro mín. 0,5 mm"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
	(constraint hole_size (min 0.5mm)))

(rule "AISLER PTH: anillo mín. 300 µm"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
	(constraint annular_width (min 0.3mm)))

(rule "AISLER NPTH: taladro mín. 0,5 mm"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical'")
	(constraint hole_size (min 0.5mm)))

(rule "AISLER cobre a NPTH mín. 250 µm"
	(condition "B.Type == 'Pad' && B.Pad_Type == 'NPTH, mechanical'")
	(constraint hole_clearance (min 0.25mm)))

(rule "AISLER serigrafía: texto mín. 0,8 mm de alto y 0,15 mm de trazo"
	(layer "?.Silkscreen")
	(condition "A.Type == 'Text' || A.Type == 'Field'")
	(constraint text_height (min 0.8mm))
	(constraint text_thickness (min 0.15mm)))
