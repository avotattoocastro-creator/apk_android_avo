rules_version = '2';

// Nube AVO (Cloud Storage for Firebase, plan Blaze). Contrato: docs/NUBE_SESIONES.md
// Cada usuario (tarjeta AVO, correo <codigo>@avo-cards.app) solo ve y escribe su carpeta trainings/<CODIGO>/.
// Solo paquetes .avo (AVO-TRAINING-1) de hasta 40 MB. Compartir con otros sigue por la Realtime Database (blobs).
// Pruebas: firebase/test/storage.test.js (emulador). Se publican a mano en la consola: Storage › Reglas.
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(owner) {
      return request.auth != null
        && request.auth.token.email == owner.lower() + '@avo-cards.app'
        && owner.matches('^AVO-[A-Z2-9]{4}-[A-Z2-9]{4}$');
    }

    // Un solo nivel: trainings/<CODIGO>/<archivo>.avo (las subcarpetas quedan denegadas por la regla final).
    match /trainings/{owner}/{file} {
      allow read: if isOwner(owner);
      allow delete: if isOwner(owner);
      allow create, update: if isOwner(owner)
        && file.matches('^[A-Za-z0-9._-]{1,140}[.]avo$')
        && request.resource.size > 0
        && request.resource.size <= 40 * 1024 * 1024
        && request.resource.metadata.sha256 is string
        && request.resource.metadata.sha256.matches('^[0-9a-f]{64}$');
    }

    match /{any=**} {
      allow read, write: if false;
    }
  }
}
