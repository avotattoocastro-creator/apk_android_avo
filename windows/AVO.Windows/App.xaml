<Application x:Class="Avo.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/AvoColors.xaml"/>
                <ResourceDictionary Source="Themes/AvoControls.xaml"/>
                <ResourceDictionary Source="Themes/AvoComponents.xaml"/>
                <ResourceDictionary Source="Themes/AvoConverters.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
