<Application x:Class="Avo.Windows.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Background" Color="#07121D"/>
  <SolidColorBrush x:Key="Surface" Color="#0C2030"/>
  <SolidColorBrush x:Key="Panel" Color="#10283B"/>
  <SolidColorBrush x:Key="Accent" Color="#158BDF"/>
  <SolidColorBrush x:Key="LabelColor" Color="#93ADC5"/>
  <Style TargetType="Window"><Setter Property="Background" Value="{StaticResource Background}"/><Setter Property="Foreground" Value="#ECF7FF"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#154D73"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="3"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Accent}"/></Trigger></Style.Triggers></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#102B40"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#27506A"/><Setter Property="Padding" Value="8"/><Setter Property="CaretBrush" Value="White"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Background" Value="#19394C"/><Setter Property="Foreground" Value="Black"/><Setter Property="Padding" Value="6"/><Setter Property="Margin" Value="4"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="#10283B"/><Setter Property="Foreground" Value="White"/><Setter Property="RowBackground" Value="#10283B"/><Setter Property="AlternatingRowBackground" Value="#153347"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="BorderThickness" Value="0"/><Setter Property="AutoGenerateColumns" Value="True"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="Margin" Value="3"/></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#CDDFEE"/><Setter Property="Background" Value="#102539"/><Setter Property="Padding" Value="11,10"/><Setter Property="BorderThickness" Value="0"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource Accent}"/></Trigger></Style.Triggers></Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="8,8,8,14"/><Setter Property="Foreground" Value="#E8F4FF"/></Style>
  <Style x:Key="StatCard" TargetType="Border"><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="BorderBrush" Value="#1D5273"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Margin" Value="5"/><Setter Property="Padding" Value="18"/></Style>
 </Application.Resources>
</Application>
