<UserControl x:Class="Avo.Windows.Views.SessionHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- AvoSessionHeader: active training, data origin badge and engine state -->
    <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
            <Border Width="4" Background="{StaticResource AvoRed}" CornerRadius="2" Margin="0,2,12,2"/>
            <StackPanel>
                <TextBlock Text="{Binding SessionHeaderTitle}" Style="{StaticResource AvoTitle}" FontSize="19"/>
                <TextBlock Text="{Binding SessionHeaderSubtitle}" Style="{StaticResource AvoDim}"/>
            </StackPanel>
            <Border Margin="16,0,0,0" VerticalAlignment="Center" CornerRadius="3" Padding="8,3" Background="#33FFC42C" BorderBrush="{StaticResource AvoWarn}" BorderThickness="1"
                    Visibility="{Binding Selected.IsSynthetic, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                <TextBlock Text="DEMOSTRACIÓN · DATOS SINTÉTICOS" Foreground="{StaticResource AvoWarn}" FontWeight="SemiBold" FontSize="11"/>
            </Border>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <!-- start / end of the useful training inside the whole recording -->
            <Border Background="{StaticResource AvoSurface2}" BorderBrush="{StaticResource AvoLine}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconFlag}" Stroke="{StaticResource AvoCyan}" Style="{StaticResource AvoIcon}" Width="14" Height="14" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding WindowText}" Margin="8,0,12,0" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                    <Button Content="Inicio = cursor" Command="{Binding WindowStartCommand}" Padding="8,3" FontWeight="Normal" FontSize="12"
                            ToolTip="Marca el inicio del entrenamiento útil en la posición del cursor (clic en mapa o gráfica, o el deslizador)"/>
                    <Button Content="Fin = cursor" Command="{Binding WindowEndCommand}" Padding="8,3" FontWeight="Normal" FontSize="12" Margin="4,0,0,0"
                            ToolTip="Marca el final del entrenamiento útil en la posición del cursor"/>
                    <Button Content="Usar selección" Command="{Binding WindowFromRangeCommand}" Padding="8,3" FontWeight="Normal" FontSize="12" Margin="4,0,0,0"
                            ToolTip="Usa el intervalo seleccionado con Mayús + arrastrar en una gráfica"/>
                    <Button Content="Archivo completo" Command="{Binding WindowResetCommand}" Padding="8,3" FontWeight="Normal" FontSize="12" Margin="4,0,0,0"/>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding Selected.EngineState, StringFormat='Motor: {0}', FallbackValue=''}" Style="{StaticResource AvoCaption}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="Reprocesar con el motor" Command="{Binding RunEngineCommand}" Padding="10,5" FontWeight="Normal"/>
        </StackPanel>
    </Grid>
</UserControl>
