<UserControl x:Class="Avo.Windows.Views.StartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Avo.Windows.Views">
    <!-- Pantalla de inicio (boceto del entrenador 13/11/2026, igual que el iPad StartView.swift): foto a pantalla completa con
         el logotipo AVO; sin panel lateral; el lema centrado abajo y un único botón «INICIAR» encima, que abre el Dashboard
         (la barra lateral vuelve en todas las páginas salvo Inicio). El lema son los mismos contornos Montserrat que antes
         estaban en HeroArt (windows/tools/hero-art/text.py, «motto»). -->
    <UserControl.Resources>
        <Style x:Key="StartButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F7F7F5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" BorderBrush="#D9F7F7F5" BorderThickness="1.5" Background="#8C12192A" Padding="64,18">
                            <Border.Effect><DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="16" Opacity="0.35"/></Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#B312192A"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.75"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <!-- photo + vector logo and lettering (sharp at any size) -->
        <Grid ClipToBounds="True" Background="#0B1020">
            <v:HeroArt/>
        </Grid>
        <!-- «INICIAR» + lema, centrados abajo, en las mismas coordenadas de diseño 2004×1098 que la foto -->
        <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Bottom">
            <Grid Width="2004" Height="1098">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,68">
                    <Button Style="{StaticResource StartButton}" HorizontalAlignment="Center" Command="{Binding NavigateCommand}" CommandParameter="Sessions"
                            AutomationProperties.AutomationId="start.iniciar" AutomationProperties.Name="Iniciar">
                        <TextBlock Text="I&#x2009;&#x2009;N&#x2009;&#x2009;I&#x2009;&#x2009;C&#x2009;&#x2009;I&#x2009;&#x2009;A&#x2009;&#x2009;R" FontSize="26" FontWeight="SemiBold"/>
