<UserControl x:Class="Avo.Windows.Views.StartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Start screen reproducing AVO_WINDOWS_CONCEPTO_02, screen 1: full-window hero photo with the AVO logo on the left and the
         five main actions in a column on the right. The photo (with logo and motto) is taken from the user's reference image. -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="StartIconFill" Color="#1F3A5C"/>
        <SolidColorBrush x:Key="StartIcon" Color="#A9C9F2"/>
        <SolidColorBrush x:Key="StartSub" Color="#8F9BAD"/>
        <SolidColorBrush x:Key="StartLine" Color="#33415466"/>
        <Style x:Key="StartAction" TargetType="Button">
            <Setter Property="Foreground" Value="#F2F4F7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="#3A4A60" BorderThickness="0,0,0,1" Padding="10,0,6,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="0.36*" MinWidth="330" MaxWidth="520"/>
        </Grid.ColumnDefinitions>
        <Grid.Background>
            <ImageBrush ImageSource="../Assets/avo_home_hero.jpg" Stretch="UniformToFill" AlignmentX="Left" AlignmentY="Center"/>
        </Grid.Background>
        <!-- right column: translucent navy panel over the photo, as in the reference -->
        <Border Grid.Column="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#E6202B3B" Offset="0"/>
                    <GradientStop Color="#F0172130" Offset="0.55"/>
                    <GradientStop Color="#F512192A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="10,0,24,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.6*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="0.6*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="#3A4A60" BorderThickness="0,0,0,1" Margin="10,0,6,0"/>
                <Button Grid.Row="1" Style="{StaticResource StartAction}" Command="{Binding ImportCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource StartIconFill}"><Path Data="{StaticResource IconOpen}" Stroke="{StaticResource StartIcon}" Style="{StaticResource AvoIcon}" Width="20" Height="20"/></Border>
                        <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Abrir entrenamiento" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="Archivos .avo / .avr" FontSize="13" Foreground="{StaticResource StartSub}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Button Grid.Row="2" Style="{StaticResource StartAction}" Command="{Binding NavigateCommand}" CommandParameter="Sessions">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource StartIconFill}"><Path Data="{StaticResource IconHistory}" Stroke="{StaticResource StartIcon}" Style="{StaticResource AvoIcon}" Width="20" Height="20"/></Border>
                        <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Sesiones recientes" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="Historial y favoritos" FontSize="13" Foreground="{StaticResource StartSub}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Button Grid.Row="3" Style="{StaticResource StartAction}" Command="{Binding NavigateCommand}" CommandParameter="Server">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource StartIconFill}"><Path Data="{StaticResource IconServer}" Stroke="{StaticResource StartIcon}" Style="{StaticResource AvoIcon}" Width="20" Height="20"/></Border>
                        <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Servidor AVO" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="Descargar sesiones" FontSize="13" Foreground="{StaticResource StartSub}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Button Grid.Row="4" Style="{StaticResource StartAction}" Command="{Binding NavigateCommand}" CommandParameter="Compare">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource StartIconFill}"><Path Data="{StaticResource IconCompare}" Stroke="{StaticResource StartIcon}" Style="{StaticResource AvoIcon}" Width="20" Height="20"/></Border>
                        <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Comparar entrenamientos" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="Análisis avanzado" FontSize="13" Foreground="{StaticResource StartSub}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Button Grid.Row="5" Style="{StaticResource StartAction}" Command="{Binding NavigateCommand}" CommandParameter="Reports">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource StartIconFill}"><Path Data="{StaticResource IconReports}" Stroke="{StaticResource StartIcon}" Style="{StaticResource AvoIcon}" Width="20" Height="20"/></Border>
                        <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Informes" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="Exportar y compartir" FontSize="13" Foreground="{StaticResource StartSub}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
