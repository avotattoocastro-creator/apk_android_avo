<UserControl x:Class="Avo.Windows.Views.AnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Avo.Windows.Controls"
             xmlns:v="clr-namespace:Avo.Windows.Views">
    <!-- Main analysis view (concept 02, screen 2): session info + layers | satellite map with playback | metric tiles -->
    <Grid Margin="16,12,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <v:SessionHeader/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>
            <!-- left: session + layers -->
            <c:AvoCard Header="Entrenamiento">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding SessionStats}">
                            <ItemsControl.ItemTemplate><DataTemplate><c:AvoKeyValue KeyText="{Binding Key}" ValueText="{Binding Value}"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Separator Margin="0,12"/>
                        <TextBlock Text="COLOREAR RECORRIDO POR" Style="{StaticResource AvoLabel}" Margin="0,0,0,6"/>
                        <RadioButton GroupName="color" Style="{StaticResource AvoSegmentButton}" HorizontalContentAlignment="Left" Margin="0,2" Content="Velocidad" IsChecked="{Binding ColorMode, Converter={StaticResource Eq}, ConverterParameter=Speed}"/>
                        <RadioButton GroupName="color" Style="{StaticResource AvoSegmentButton}" HorizontalContentAlignment="Left" Margin="0,2" Content="Aceleración" IsChecked="{Binding ColorMode, Converter={StaticResource Eq}, ConverterParameter=Acceleration}"/>
                        <RadioButton GroupName="color" Style="{StaticResource AvoSegmentButton}" HorizontalContentAlignment="Left" Margin="0,2" Content="Calidad GNSS / RTK" IsChecked="{Binding ColorMode, Converter={StaticResource Eq}, ConverterParameter=GnssQuality}"/>
                        <RadioButton GroupName="color" Style="{StaticResource AvoSegmentButton}" HorizontalContentAlignment="Left" Margin="0,2" Content="Aire (motor, cincha)" IsChecked="{Binding ColorMode, Converter={StaticResource Eq}, ConverterParameter=Gait}"/>
                        <Separator Margin="0,12"/>
                        <TextBlock Text="CAPAS" Style="{StaticResource AvoLabel}" Margin="0,0,0,4"/>
                        <CheckBox Content="Recorrido GNSS / RTK" IsChecked="{Binding ShowRoute, ElementName=Map}"/>
                        <CheckBox Content="Inicio y final" IsChecked="{Binding ShowMarkers, ElementName=Map}"/>
                        <TextBlock Text="{Binding Selected.GirthText, StringFormat='Cincha: {0}', FallbackValue=''}" Style="{StaticResource AvoCaption}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="La trayectoria es la del chaleco GNSS del jinete, no un punto anatómico del caballo." Style="{StaticResource AvoCaption}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </c:AvoCard>

            <!-- centre: map + playback -->
            <Grid Grid.Column="1" Margin="12,0">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border CornerRadius="8" ClipToBounds="True" BorderBrush="{StaticResource AvoLine}" BorderThickness="1">
                    <Grid>
                        <c:MapControl x:Name="Map" Tracks="{Binding Tracks}" CursorTime="{Binding CursorTime}" ColorMode="{Binding ColorMode}" Provider="{Binding MapProvider}"
                                      RangeStart="{Binding RangeStart}" RangeEnd="{Binding RangeEnd}" TileCacheDir="{Binding TileCacheDir}" FitPadding="190,60,60,40"/>
                        <!-- legend -->
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="12,9" Background="#E6101014" BorderBrush="{StaticResource AvoLine}" BorderThickness="1" CornerRadius="6" Width="168">
                            <StackPanel>
                                <TextBlock Text="{Binding LegendTitle}" FontWeight="SemiBold" FontSize="12"/>
                                <Border Height="8" CornerRadius="2" Margin="0,8,0,4" Background="{StaticResource AvoSpeedScale}"/>
                                <Grid>
                                    <TextBlock Text="0" Style="{StaticResource AvoCaption}"/>
                                    <TextBlock Text="{Binding Selected.MaxSpeedText, FallbackValue=''}" Style="{StaticResource AvoCaption}" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="RTK: FIX · FLOAT · DGNSS · autónomo · sin solución" Style="{StaticResource AvoCaption}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="10"/>
                            </StackPanel>
                        </Border>
                        <!-- toolbar -->
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12">
                            <c:AvoMapToolbar>
                                <RadioButton GroupName="prov" Style="{StaticResource AvoSegmentButton}" Content="Mapa" BorderThickness="0" IsChecked="{Binding MapProvider, Converter={StaticResource Eq}, ConverterParameter=VectorOffline}"/>
                                <RadioButton GroupName="prov" Style="{StaticResource AvoSegmentButton}" Content="Satélite" BorderThickness="0" IsChecked="{Binding MapProvider, Converter={StaticResource Eq}, ConverterParameter=EsriSatellite}"/>
                                <RadioButton GroupName="prov" Style="{StaticResource AvoSegmentButton}" Content="Híbrido" BorderThickness="0" IsChecked="{Binding MapProvider, Converter={StaticResource Eq}, ConverterParameter=EsriHybrid}"/>
                            </c:AvoMapToolbar>
                            <StackPanel HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button Style="{StaticResource AvoIconButton}" Click="ZoomIn" ToolTip="Acercar"><Path Data="{StaticResource IconPlus}" Stroke="{StaticResource AvoText}" Style="{StaticResource AvoIcon}" Width="14" Height="14"/></Button>
                                <Button Style="{StaticResource AvoIconButton}" Click="ZoomOut" ToolTip="Alejar" Margin="0,4,0,0"><Path Data="{StaticResource IconMinus}" Stroke="{StaticResource AvoText}" Style="{StaticResource AvoIcon}" Width="14" Height="14"/></Button>
                                <Button Style="{StaticResource AvoIconButton}" Click="Fit" ToolTip="Ajustar recorrido a pantalla" Margin="0,4,0,0"><Path Data="{StaticResource IconFit}" Stroke="{StaticResource AvoText}" Style="{StaticResource AvoIcon}" Width="14" Height="14"/></Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- playback bar -->
                <Border Grid.Row="1" Margin="0,10,0,0" Padding="12,8" Background="{StaticResource AvoCardBrush}" BorderBrush="{StaticResource AvoLine}" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource AvoIconButton}" Command="{Binding PlayCommand}" ToolTip="Reproducir / pausar">
                            <Grid>
                                <Path Data="{StaticResource IconPlay}" Fill="{StaticResource AvoText}" Stroke="{StaticResource AvoText}" Style="{StaticResource AvoIcon}" Width="12" Height="12" Visibility="{Binding IsPlaying, Converter={StaticResource NotBoolVis}}"/>
                                <Path Data="{StaticResource IconPause}" Stroke="{StaticResource AvoText}" StrokeThickness="2.6" Style="{StaticResource AvoIcon}" Width="12" Height="12" Visibility="{Binding IsPlaying, Converter={StaticResource BoolVis}}"/>
                            </Grid>
                        </Button>
                        <Slider Grid.Column="1" Margin="14,0" Minimum="0" Maximum="{Binding TimelineEnd}" Value="{Binding CursorTime}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding PlaybackText}" Style="{StaticResource AvoValue}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ComboBox Grid.Column="3" Width="76" ItemsSource="{Binding PlaybackSpeeds}" SelectedItem="{Binding PlaybackSpeed}" ItemStringFormat="{}{0}×" ToolTip="Velocidad de reproducción"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- right: metric tiles with sparklines -->
            <UniformGrid Grid.Column="2" Rows="4">
                <c:AvoMetricTile Label="VELOCIDAD (km/h)" Value="{Binding CursorSpeed}" Caption="Filtrada en el cursor" Margin="0,0,0,8">
                    <c:Sparkline Values="{Binding SpeedSpark}" Stroke="{StaticResource AvoBlue}" Height="44"/>
                </c:AvoMetricTile>
                <c:AvoMetricTile Label="ACELERACIÓN (m/s²)" Value="{Binding CursorAccel}" Caption="Longitudinal validada" Margin="0,0,0,8">
                    <c:Sparkline Values="{Binding AccelSpark}" Stroke="{StaticResource AvoRed}" Height="44"/>
                </c:AvoMetricTile>
                <c:AvoMetricTile Label="ALTITUD (m)" Value="{Binding CursorAltitude}" Caption="GNSS sobre el nivel medio del mar" Margin="0,0,0,8">
                    <c:Sparkline Values="{Binding AltitudeSpark}" Stroke="{StaticResource AvoOk}" Height="44"/>
                </c:AvoMetricTile>
                <c:AvoMetricTile Label="CADENCIA (ciclos/min)" Value="{Binding CursorCadence}" Caption="Cincha · motor AVO (sin datos = —)">
                    <c:Sparkline Values="{Binding CadenceSpark}" Stroke="{StaticResource AvoCyan}" Height="44"/>
                </c:AvoMetricTile>
            </UniformGrid>
        </Grid>
    </Grid>
</UserControl>
