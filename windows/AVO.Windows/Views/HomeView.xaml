<UserControl x:Class="Avo.Windows.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Avo.Windows.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20,16,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Dashboard (boceto del entrenador 13/11/2026, igual que el iPad): la imagen sola; a la derecha cifras que interesan a
                 primera vista en lugar de botones; debajo, los últimos entrenamientos en lugar de la fila de totales -->
            <Grid Height="380">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>
                <Border CornerRadius="8" ClipToBounds="True" BorderBrush="{StaticResource AvoLine}" BorderThickness="1">
                    <Border.Background>
                        <ImageBrush ImageSource="../Assets/avo_brand_hero.jpg" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/>
                    </Border.Background>
                </Border>
                <Border Grid.Column="1" Margin="14,0,0,0" Background="{StaticResource AvoCardBrush}" BorderBrush="{StaticResource AvoLine}" BorderThickness="1" CornerRadius="8">
                    <UniformGrid Rows="5" Margin="8">
                        <UniformGrid.Resources>
                            <Style x:Key="Counter" TargetType="Button" BasedOn="{StaticResource AvoGhostButton}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="12,6"/>
                                <Setter Property="Margin" Value="0,1"/>
                            </Style>
                        </UniformGrid.Resources>
                        <Button Style="{StaticResource Counter}" Command="{Binding NavigateCommand}" CommandParameter="Stable">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding HorseCount}" FontSize="32" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource AvoRedSoft}"><Path Data="{StaticResource IconHorse}" Stroke="{StaticResource AvoRedLight}" Style="{StaticResource AvoIcon}"/></Border>
                                <StackPanel Margin="14,0,8,0" VerticalAlignment="Center"><TextBlock Text="CABALLOS" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AvoSilver}"/><TextBlock Text="Activos en la cuadra" Style="{StaticResource AvoCaption}"/></StackPanel>
                            </DockPanel>
                        </Button>
                        <Button Style="{StaticResource Counter}" Command="{Binding NavigateCommand}" CommandParameter="Riders">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding RiderCount}" FontSize="32" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource AvoRedSoft}"><Path Data="{StaticResource IconRider}" Stroke="{StaticResource AvoRedLight}" Style="{StaticResource AvoIcon}"/></Border>
                                <StackPanel Margin="14,0,8,0" VerticalAlignment="Center"><TextBlock Text="JOCKEYS" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AvoSilver}"/><TextBlock Text="Jinetes activos" Style="{StaticResource AvoCaption}"/></StackPanel>
                            </DockPanel>
                        </Button>
                        <Button Style="{StaticResource Counter}" Command="{Binding NavigateCommand}" CommandParameter="Sessions">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Dashboard.Trainings}" FontSize="32" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource AvoRedSoft}"><Path Data="{StaticResource IconHistory}" Stroke="{StaticResource AvoRedLight}" Style="{StaticResource AvoIcon}"/></Border>
                                <StackPanel Margin="14,0,8,0" VerticalAlignment="Center"><TextBlock Text="ENTRENAMIENTOS" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AvoSilver}"/><TextBlock Text="En el PC" Style="{StaticResource AvoCaption}"/></StackPanel>
                            </DockPanel>
                        </Button>
                        <Button Style="{StaticResource Counter}" Command="{Binding NavigateCommand}" CommandParameter="Calendar">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Dashboard.ThisWeek}" FontSize="32" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource AvoRedSoft}"><Path Data="{StaticResource IconHistory}" Stroke="{StaticResource AvoRedLight}" Style="{StaticResource AvoIcon}"/></Border>
                                <StackPanel Margin="14,0,8,0" VerticalAlignment="Center"><TextBlock Text="ESTA SEMANA" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AvoSilver}"/><TextBlock Text="De lunes a domingo" Style="{StaticResource AvoCaption}"/></StackPanel>
                            </DockPanel>
                        </Button>
                        <Button Style="{StaticResource Counter}" Command="{Binding NavigateCommand}" CommandParameter="Sessions">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Dashboard.Pending}" FontSize="32" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource AvoWarn}"/>
                                <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource AvoRedSoft}"><Path Data="{StaticResource IconFlag}" Stroke="{StaticResource AvoRedLight}" Style="{StaticResource AvoIcon}"/></Border>
                                <StackPanel Margin="14,0,8,0" VerticalAlignment="Center"><TextBlock Text="POR REVISAR" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AvoSilver}"/><TextBlock Text="Sin caballo o sin analizar" Style="{StaticResource AvoCaption}"/></StackPanel>
                            </DockPanel>
                        </Button>
                    </UniformGrid>
                </Border>
            </Grid>

            <!-- últimos entrenamientos -->
            <StackPanel Grid.Row="1" Margin="0,14,0,0">
                <TextBlock Text="ÚLTIMOS ENTRENAMIENTOS" Style="{StaticResource AvoLabel}" Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding Dashboard.Latest}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5" VerticalAlignment="Top"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource AvoGhostButton}" Margin="0,0,10,0" Padding="0" HorizontalContentAlignment="Stretch" CommandParameter="{Binding}"
                                    Command="{Binding DataContext.OpenDashCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <Border Padding="12" Height="104" CornerRadius="8" Background="{StaticResource AvoCardBrush}" BorderBrush="{StaticResource AvoLine}" BorderThickness="1">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Quality}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding QualityColor}"/>
                                            <TextBlock Foreground="{StaticResource AvoRedLight}" FontWeight="Bold" FontSize="12">
                                                <Run Text="{Binding DayText, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding TimeText, Mode=OneWay}" Foreground="{StaticResource AvoTextDim}" FontWeight="Normal"/>
                                            </TextBlock>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Horse}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AvoText}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                        <TextBlock Foreground="{StaticResource AvoSilver}" Margin="0,2,0,0">
                                            <Run Text="{Binding DistanceText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding DurationText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- trainings / horses / status (concept 01, screen 1) -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>
                <c:AvoCard Header="Sesiones recientes · historial y favoritos" MinHeight="360">
                    <c:AvoCard.HeaderTools>
                        <StackPanel Orientation="Horizontal">
                        <!-- «Abrir» e «Importar carpeta» viven aquí: las páginas generales ya no tienen barra superior -->
                        <Button Style="{StaticResource AvoPrimaryButton}" Content="Abrir" Command="{Binding ImportCommand}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource AvoGhostButton}" Content="Importar carpeta" Command="{Binding ImportFolderCommand}" Margin="0,0,14,0"/>
                        <CheckBox Content="Solo favoritos" IsChecked="{Binding OnlyFavorites}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <Grid Width="260">
                            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="30,5,8,5"/>
                            <Path Data="{StaticResource IconSearch}" Stroke="{StaticResource AvoTextDim}" Style="{StaticResource AvoIcon}" Width="14" Height="14" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False"/>
                        </Grid>
                        </StackPanel>
                    </c:AvoCard.HeaderTools>
                    <DataGrid Style="{StaticResource AvoDataTable}" ItemsSource="{Binding SessionsView}" SelectedItem="{Binding Selected}" CanUserSortColumns="True" MinHeight="300">
                        <DataGrid.InputBindings>
                            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding NavigateCommand}" CommandParameter="Analysis"/>
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="★" Width="36" SortMemberPath="IsFavorite">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource AvoGhostButton}" Padding="2" ToolTip="Marcar / quitar favorito"
                                                Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                            <TextBlock x:Name="Star" Text="☆" FontSize="15" Foreground="{StaticResource AvoTextDim}"/>
                                        </Button>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                <Setter TargetName="Star" Property="Text" Value="★"/>
                                                <Setter TargetName="Star" Property="Foreground" Value="{StaticResource AvoWarn}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding DateTimeText}" SortMemberPath="Start" Width="130"/>
                            <DataGridTextColumn Header="Caballo" Binding="{Binding Horse}" Width="*" MinWidth="110"/>
                            <DataGridTextColumn Header="Jinete" Binding="{Binding Rider}" Width="*" MinWidth="110"/>
                            <DataGridTextColumn Header="Distancia" Binding="{Binding DistanceText}" SortMemberPath="DistanceKmValue" Width="90"/>
                            <DataGridTextColumn Header="V. máx" Binding="{Binding MaxSpeedText}" SortMemberPath="MaxSpeedKmh" Width="90"/>
                            <DataGridTemplateColumn Header="" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button x:Name="Assign" Content="Asignar" Padding="8,2" ToolTip="Asignar caballo y jinete"
                                                Command="{Binding DataContext.OpenAssignCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding NeedsIdentity}" Value="True">
                                                <Setter TargetName="Assign" Property="Background" Value="{StaticResource AvoRed}"/>
                                                <Setter TargetName="Assign" Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </c:AvoCard>
                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <c:AvoCard Header="Reloj de pecho (USB)" Accent="{StaticResource AvoCyan}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding UsbStatus}" Style="{StaticResource AvoDim}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Sincronizar reloj" Style="{StaticResource AvoPrimaryButton}" Command="{Binding UsbSyncCommand}" Padding="12,5"/>
                                <Button Content="Abrir carpeta" Command="{Binding UsbFolderCommand}" Padding="12,5" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding UsbFolder}" Style="{StaticResource AvoCaption}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </c:AvoCard>
                    <c:AvoCard Header="Caballos">
                        <c:AvoCard.HeaderTools>
                            <Button Style="{StaticResource AvoGhostButton}" Content="Ver cuadra ›" Padding="6,2" Command="{Binding NavigateCommand}" CommandParameter="Stable"/>
                        </c:AvoCard.HeaderTools>
                        <ItemsControl ItemsSource="{Binding Horses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource AvoSurface2}" BorderBrush="{StaticResource AvoLine}" BorderThickness="1">
                                            <Path Data="{StaticResource IconHorse}" Stroke="{StaticResource AvoSilver}" Style="{StaticResource AvoIcon}" Width="16" Height="16"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Style="{StaticResource AvoCaption}"><Run Text="{Binding Sessions, Mode=OneWay}"/><Run Text=" entrenamientos · último "/><Run Text="{Binding LastDate, Mode=OneWay}"/></TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding BestSpeed}" Style="{StaticResource AvoValue}" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </c:AvoCard>
                    <c:AvoCard Header="Calidad y disponibilidad de sensores" Margin="0,12,0,0">
                        <ItemsControl ItemsSource="{Binding SensorStatus}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><c:AvoKeyValue KeyText="{Binding Key}" ValueText="{Binding Value}"/></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </c:AvoCard>
                    <c:AvoCard Header="Estado de importaciones" Margin="0,12,0,0">
                        <ItemsControl ItemsSource="{Binding ImportLog}" MaxHeight="150">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource AvoOk}" VerticalAlignment="Top" Margin="0,5,8,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding File}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Result}" Style="{StaticResource AvoCaption}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Ok}" Value="False"><Setter TargetName="Dot" Property="Fill" Value="{StaticResource AvoBad}"/></DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </c:AvoCard>
                    <c:AvoCard Header="Estado del sistema" Margin="0,12,0,0">
                        <StackPanel>
                            <c:AvoStatusIndicator Text="Motor AVO Performance Equine" Detail="{Binding EngineShort}" State="{Binding EngineIndicator}" ToolTip="{Binding EngineInfo}"/>
                            <c:AvoStatusIndicator Text="Importación segura (SHA-256 / CRC)" Detail="Activa" State="Ok"/>
                            <c:AvoStatusIndicator Text="Servidor AVO" Detail="Contrato pendiente" State="Warning"/>
                            <c:AvoStatusIndicator Text="Mareas IHM / Open-Meteo" Detail="Bajo demanda" State="Info"/>
                        </StackPanel>
                    </c:AvoCard>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
