<UserControl x:Class="Avo.Windows.Views.GeofencesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Avo.Windows.Controls">
    <!-- Geofences and start/finish lines of the chest watch: same slots and format as the Android app (SET_FENCE,
         SET_ACTIVE_FENCES, SET_CONFIG lines), sent over Bluetooth. -->
    <Grid Margin="20,16,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.27*" MinWidth="300" MaxWidth="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= left: watch, fences, lines -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <c:AvoCard Header="Reloj de pecho" Accent="{StaticResource AvoCyan}">
                    <StackPanel>
                        <TextBlock Text="{Binding GeoSummary}" Style="{StaticResource AvoDim}" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource AvoPrimaryButton}" Command="{Binding SendToWatchCommand}" Padding="14,6" IsEnabled="{Binding WatchBusy, Converter={StaticResource Not}}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconExport}" Stroke="White" Style="{StaticResource AvoIcon}" Width="14" Height="14"/>
                                    <TextBlock Text="Enviar al reloj" Margin="7,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Content="Leer del reloj" Command="{Binding ReadFromWatchCommand}" Padding="12,6" Margin="8,0,0,0" IsEnabled="{Binding WatchBusy, Converter={StaticResource Not}}"/>
                        </StackPanel>
                        <ProgressBar Height="3" IsIndeterminate="True" Margin="0,8,0,0" Visibility="{Binding WatchBusy, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Text="{Binding WatchLinkStatus}" Style="{StaticResource AvoCaption}" Foreground="{StaticResource AvoCyan}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <CheckBox Content="Grabación automática al entrar en una geocerca activa" IsChecked="{Binding GeoAuto}" Margin="0,10,0,0"/>
                        <TextBlock Style="{StaticResource AvoCaption}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="Bluetooth del PC, mismo formato que la app Android: el reloj no se modifica. La primera vez, el reloj pide pulsar BOOT para autorizar este PC. Si el móvil está conectado al reloj, desconéctalo antes."/>
                    </StackPanel>
                </c:AvoCard>

                <c:AvoCard Header="Geocercas (8 huecos del reloj)" Margin="0,12,0,0">
                    <ListBox ItemsSource="{Binding FenceSlots}" SelectedItem="{Binding SelectedFenceSlot}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Path DockPanel.Dock="Right" Data="{StaticResource IconWarning}" Stroke="{StaticResource AvoWarn}" Style="{StaticResource AvoIcon}" Width="14" Height="14"
                                          ToolTip="{Binding Problem}" Visibility="{Binding HasProblem, Converter={StaticResource BoolVis}}"/>
                                    <StackPanel>
                                        <TextBlock x:Name="T" Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource AvoCaption}"/>
                                    </StackPanel>
                                </DockPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True"><Setter TargetName="T" Property="Foreground" Value="{StaticResource AvoTextDim}"/></DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </c:AvoCard>

                <c:AvoCard Header="Líneas de salida y meta (4 del reloj)" Margin="0,12,0,0">
                    <ListBox ItemsSource="{Binding LineSlots}" SelectedItem="{Binding SelectedLineSlot}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Path DockPanel.Dock="Right" Data="{StaticResource IconWarning}" Stroke="{StaticResource AvoWarn}" Style="{StaticResource AvoIcon}" Width="14" Height="14"
                                          ToolTip="{Binding Problem}" Visibility="{Binding HasProblem, Converter={StaticResource BoolVis}}"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource AvoCaption}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </c:AvoCard>
                <TextBlock Text="{Binding GeoProblems}" Style="{StaticResource AvoCaption}" Foreground="{StaticResource AvoWarn}" TextWrapping="Wrap" Margin="4,10,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= right: map, editor, crossings -->
        <Grid Grid.Column="1" Margin="14,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="260"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border BorderBrush="{StaticResource AvoLine}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                <Grid>
                    <c:MapControl Tracks="{Binding Tracks}" Shapes="{Binding GeoShapes}" MapClickCommand="{Binding MapClickCommand}" CursorTime="{Binding CursorTime}"
                                  ColorMode="Single" Provider="{Binding MapProvider}" TileCacheDir="{Binding TileCacheDir}" FitPadding="40,60,40,40" Cursor="Cross"/>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="10,6" Background="#E6101014" BorderBrush="{StaticResource AvoLine}" BorderThickness="1" CornerRadius="6" MaxWidth="560">
                        <TextBlock Text="{Binding GeoHint}" TextWrapping="Wrap" FontSize="12.5"/>
                    </Border>
                </Grid>
            </Border>

            <!-- editor -->
            <c:AvoCard Grid.Row="1" Margin="0,12,0,0" Header="Edición">
                <Grid>
                    <!-- fence -->
                    <StackPanel Visibility="{Binding EditingFence, Converter={StaticResource BoolVis}}">
                        <WrapPanel>
                            <Button Content="Círculo" Command="{Binding NewCircleCommand}" Padding="12,5" Margin="0,0,6,6"/>
                            <Button Content="Polígono" Command="{Binding NewPolygonCommand}" Padding="12,5" Margin="0,0,16,6"/>
                            <Button Content="Deshacer vértice" Command="{Binding UndoVertexCommand}" Padding="10,5" Margin="0,0,6,6" Visibility="{Binding EditingPolygon, Converter={StaticResource BoolVis}}"/>
                            <Button Content="Borrar forma" Command="{Binding ClearShapeCommand}" Padding="10,5" Margin="0,0,6,6" Visibility="{Binding EditingFenceShape, Converter={StaticResource BoolVis}}"/>
                            <Button Style="{StaticResource AvoGhostButton}" Content="Vaciar hueco" Command="{Binding DeleteFenceCommand}" Padding="10,5" Margin="0,0,6,6" Foreground="{StaticResource AvoBad}"
                                    Visibility="{Binding EditingFenceShape, Converter={StaticResource BoolVis}}"/>
                        </WrapPanel>
                        <Grid Visibility="{Binding EditingFenceShape, Converter={StaticResource BoolVis}}" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="NOMBRE (MÁX. 15)" Style="{StaticResource AvoLabel}"/>
                                <TextBox Text="{Binding FenceName, UpdateSourceTrigger=PropertyChanged}" MaxLength="15" Margin="0,4,0,0"/>
                                <CheckBox Content="Activa (grabación automática)" IsChecked="{Binding FenceActive}" Margin="0,8,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Visibility="{Binding EditingCircle, Converter={StaticResource BoolVis}}">
                                <TextBlock Style="{StaticResource AvoLabel}"><Run Text="RADIO: "/><Run Text="{Binding FenceRadius, Mode=OneWay, StringFormat='0'}"/><Run Text=" m (5 m – 5 km)"/></TextBlock>
                                <Slider Minimum="5" Maximum="1000" Value="{Binding FenceRadius}" Margin="0,8,0,0" SmallChange="1" LargeChange="10"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <!-- line -->
                    <StackPanel Visibility="{Binding EditingLine, Converter={StaticResource BoolVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="NOMBRE" Style="{StaticResource AvoLabel}"/>
                                <TextBox Text="{Binding LineName, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" Margin="0,4,0,0"/>
                                <CheckBox Content="Línea activa" IsChecked="{Binding LineEnabled}" Margin="0,8,0,0"/>
                                <Button Content="Borrar extremos" Command="{Binding ClearShapeCommand}" Padding="10,4" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="USO" Style="{StaticResource AvoLabel}"/>
                                <WrapPanel Margin="0,4,0,0">
                                    <RadioButton GroupName="role" Style="{StaticResource AvoSegmentButton}" Content="Salida y meta (vueltas)" Margin="0,0,4,4" IsChecked="{Binding SelectedLineRole, Converter={StaticResource Eq}, ConverterParameter=StartFinish}"/>
                                    <RadioButton GroupName="role" Style="{StaticResource AvoSegmentButton}" Content="Salida" Margin="0,0,4,4" IsChecked="{Binding SelectedLineRole, Converter={StaticResource Eq}, ConverterParameter=Start}"/>
                                    <RadioButton GroupName="role" Style="{StaticResource AvoSegmentButton}" Content="Meta" Margin="0,0,4,4" IsChecked="{Binding SelectedLineRole, Converter={StaticResource Eq}, ConverterParameter=Finish}"/>
                                    <RadioButton GroupName="role" Style="{StaticResource AvoSegmentButton}" Content="Control" Margin="0,0,4,4" IsChecked="{Binding SelectedLineRole, Converter={StaticResource Eq}, ConverterParameter=Checkpoint}"/>
                                </WrapPanel>
                                <TextBlock Text="SENTIDO EN QUE MARCA (FLECHA DEL MAPA)" Style="{StaticResource AvoLabel}" Margin="0,8,0,0"/>
                                <WrapPanel Margin="0,4,0,0">
                                    <RadioButton GroupName="dir" Style="{StaticResource AvoSegmentButton}" Content="Ambos sentidos" Margin="0,0,4,4" IsChecked="{Binding SelectedLineDirection, Converter={StaticResource Eq}, ConverterParameter=Both}"/>
                                    <RadioButton GroupName="dir" Style="{StaticResource AvoSegmentButton}" Content="Solo en el sentido de la flecha" Margin="0,0,4,4" IsChecked="{Binding SelectedLineDirection, Converter={StaticResource Eq}, ConverterParameter=LeftToRight}"/>
                                    <RadioButton GroupName="dir" Style="{StaticResource AvoSegmentButton}" Content="Solo en sentido contrario" Margin="0,0,4,4" IsChecked="{Binding SelectedLineDirection, Converter={StaticResource Eq}, ConverterParameter=RightToLeft}"/>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource AvoCaption}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource AvoWarn}"
                                           Text="El reloj recibe la línea tal cual y cuenta los cruces en los dos sentidos (su firmware no guarda sentido; la línea 1 cronometra vueltas). El sentido elegido se aplica en este PC al analizar el entrenamiento: los cruces al revés aparecen como «No marca»."/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <TextBlock Text="Elige una geocerca o una línea a la izquierda.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource AvoDim}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding EditingFence}" Value="False"/>
                                            <Condition Binding="{Binding EditingLine}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </c:AvoCard>
            <TextBlock Grid.Row="1" Text="{Binding GeoProblem}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,22,18,0" FontSize="12">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource AvoWarn}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding GeoProblemOk}" Value="True"><Setter Property="Foreground" Value="{StaticResource AvoOk}"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- crossings of the active training -->
            <c:AvoCard Grid.Row="2" Margin="0,12,0,0" Header="{Binding CrossingsTitle}">
                <c:AvoCard.HeaderTools>
                    <Button Content="Crear tramos con estos tiempos" Command="{Binding LinesToSegmentsCommand}" Padding="10,4"/>
                </c:AvoCard.HeaderTools>
                <Grid MaxHeight="190">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.ColumnSpan="3" Text="{Binding CrossingsEmpty}" Style="{StaticResource AvoDim}" TextWrapping="Wrap"/>
                    <DataGrid Style="{StaticResource AvoDataTable}" ItemsSource="{Binding CrossingRows}" Visibility="{Binding CrossingRows.Count, Converter={StaticResource NonZeroVis}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Línea" Binding="{Binding Line}" Width="*"/>
                            <DataGridTextColumn Header="Hora" Binding="{Binding Time}" Width="70"/>
                            <DataGridTextColumn Header="Sentido" Binding="{Binding Direction}" Width="140"/>
                            <DataGridTemplateColumn Header="" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="M" Text="{Binding CountsText}" FontWeight="SemiBold" Foreground="{StaticResource AvoOk}"/>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Counts}" Value="False"><Setter TargetName="M" Property="Foreground" Value="{StaticResource AvoTextDim}"/></DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DataGrid Grid.Column="2" Style="{StaticResource AvoDataTable}" ItemsSource="{Binding RunRows}" Visibility="{Binding RunRows.Count, Converter={StaticResource NonZeroVis}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Vuelta / tramo" Binding="{Binding Kind}" Width="*"/>
                            <DataGridTextColumn Header="Inicio" Binding="{Binding Start}" Width="70"/>
                            <DataGridTextColumn Header="Tiempo" Binding="{Binding Duration}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </c:AvoCard>
        </Grid>
    </Grid>
</UserControl>
