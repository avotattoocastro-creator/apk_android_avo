<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- AVO corporate palette — taken 1:1 from app/src/main/kotlin/org/avoperformance/horse/ui/theme/Theme.kt (AvoColors).
         Every colour of the Windows app must come from this dictionary. -->
    <Color x:Key="AvoBgColor">#030406</Color>
    <Color x:Key="AvoSurfaceColor">#101014</Color>
    <Color x:Key="AvoSurface2Color">#1A1B20</Color>
    <Color x:Key="AvoLineColor">#2A2B31</Color>
    <Color x:Key="AvoRedColor">#ED122A</Color>
    <Color x:Key="AvoRedDarkColor">#B71625</Color>
    <Color x:Key="AvoRedLightColor">#FF495A</Color>
    <Color x:Key="AvoBlueColor">#3D9BFF</Color>
    <Color x:Key="AvoCyanColor">#35D0E8</Color>
    <Color x:Key="AvoSilverColor">#C9CBD1</Color>
    <Color x:Key="AvoTextColor">#F2F2F4</Color>
    <Color x:Key="AvoTextDimColor">#9C9DA4</Color>
    <Color x:Key="AvoOkColor">#52DD40</Color>
    <Color x:Key="AvoWarnColor">#FFC42C</Color>
    <Color x:Key="AvoBadColor">#FF3945</Color>
    <Color x:Key="AvoUnknownColor">#93949B</Color>
    <!-- Card gradient of Android (AvoColors.CardBrush: #15161B → #0D0D11) -->
    <Color x:Key="AvoCardTopColor">#15161B</Color>
    <Color x:Key="AvoCardBottomColor">#0D0D11</Color>

    <SolidColorBrush x:Key="AvoBg" Color="{StaticResource AvoBgColor}"/>
    <SolidColorBrush x:Key="AvoSurface" Color="{StaticResource AvoSurfaceColor}"/>
    <SolidColorBrush x:Key="AvoSurface2" Color="{StaticResource AvoSurface2Color}"/>
    <SolidColorBrush x:Key="AvoLine" Color="{StaticResource AvoLineColor}"/>
    <SolidColorBrush x:Key="AvoRed" Color="{StaticResource AvoRedColor}"/>
    <SolidColorBrush x:Key="AvoRedDark" Color="{StaticResource AvoRedDarkColor}"/>
    <SolidColorBrush x:Key="AvoRedLight" Color="{StaticResource AvoRedLightColor}"/>
    <SolidColorBrush x:Key="AvoBlue" Color="{StaticResource AvoBlueColor}"/>
    <SolidColorBrush x:Key="AvoCyan" Color="{StaticResource AvoCyanColor}"/>
    <SolidColorBrush x:Key="AvoSilver" Color="{StaticResource AvoSilverColor}"/>
    <SolidColorBrush x:Key="AvoText" Color="{StaticResource AvoTextColor}"/>
    <SolidColorBrush x:Key="AvoTextDim" Color="{StaticResource AvoTextDimColor}"/>
    <SolidColorBrush x:Key="AvoOk" Color="{StaticResource AvoOkColor}"/>
    <SolidColorBrush x:Key="AvoWarn" Color="{StaticResource AvoWarnColor}"/>
    <SolidColorBrush x:Key="AvoBad" Color="{StaticResource AvoBadColor}"/>
    <SolidColorBrush x:Key="AvoUnknown" Color="{StaticResource AvoUnknownColor}"/>
    <SolidColorBrush x:Key="AvoRedSoft" Color="#33ED122A"/>
    <SolidColorBrush x:Key="AvoHover" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="AvoPressed" Color="#22FFFFFF"/>
    <LinearGradientBrush x:Key="AvoCardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource AvoCardTopColor}" Offset="0"/>
        <GradientStop Color="{StaticResource AvoCardBottomColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AvoHeaderBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0A0B0E" Offset="0"/>
        <GradientStop Color="#15161B" Offset="0.6"/>
        <GradientStop Color="#0A0B0E" Offset="1"/>
    </LinearGradientBrush>
    <!-- Speed scale shared with Android TrainingDetailScreen.kt: blue → cyan → yellow → red -->
    <LinearGradientBrush x:Key="AvoSpeedScale" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2F6BFF" Offset="0"/>
        <GradientStop Color="#35D0E8" Offset="0.33"/>
        <GradientStop Color="#FFC42C" Offset="0.66"/>
        <GradientStop Color="#ED122A" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AvoAccelScale" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#3D9BFF" Offset="0"/>
        <GradientStop Color="#93949B" Offset="0.5"/>
        <GradientStop Color="#ED122A" Offset="1"/>
    </LinearGradientBrush>

    <!-- Typography (Segoe UI Variable / Segoe UI; numbers with tabular figures) -->
    <FontFamily x:Key="AvoFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="AvoDisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <sys:Double x:Key="AvoFontCaption">11</sys:Double>
    <sys:Double x:Key="AvoFontBody">13</sys:Double>
    <sys:Double x:Key="AvoFontSubtitle">15</sys:Double>
    <sys:Double x:Key="AvoFontTitle">20</sys:Double>
    <sys:Double x:Key="AvoFontMetric">28</sys:Double>
    <CornerRadius x:Key="AvoRadius">6</CornerRadius>
    <CornerRadius x:Key="AvoRadiusSmall">4</CornerRadius>
    <Thickness x:Key="AvoCardPadding">16,12,16,14</Thickness>

