<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Avo.Windows.ViewModels">
    <vm:PageVisibility x:Key="PageVis"/>
    <vm:NotPageVisibility x:Key="NotPageVis"/>
    <vm:EqualsConverter x:Key="Eq"/>
    <vm:BoolVisibility x:Key="BoolVis"/>
    <vm:BoolVisibility x:Key="NotBoolVis" Invert="True"/>
    <vm:NullVisibility x:Key="NullVis"/>
    <vm:ColorBrush x:Key="ColorBrush"/>
    <vm:ClockConverter x:Key="Clock"/>
    <vm:NotConverter x:Key="Not"/>
    <vm:ZeroVisibility x:Key="ZeroVis"/>
    <vm:ZeroVisibility x:Key="NonZeroVis" Invert="True"/>
</ResourceDictionary>
