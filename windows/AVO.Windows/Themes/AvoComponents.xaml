<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Avo.Windows.Controls">

    <Style TargetType="c:AvoCard">
        <Setter Property="Background" Value="{StaticResource AvoCardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AvoLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="{StaticResource AvoCardPadding}"/>
        <Setter Property="Foreground" Value="{StaticResource AvoText}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:AvoCard">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource AvoRadius}" SnapsToDevicePixels="True">
                        <Grid>
                            <Border Width="3" HorizontalAlignment="Left" Background="{TemplateBinding Accent}" CornerRadius="6,0,0,6"/>
                            <DockPanel Margin="{TemplateBinding Padding}">
                                <Grid x:Name="Head" DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center" TextElement.FontSize="14" TextElement.FontWeight="SemiBold"/>
                                    <ContentPresenter Grid.Column="1" Content="{TemplateBinding HeaderTools}" VerticalAlignment="Center"/>
                                </Grid>
                                <ContentPresenter/>
                            </DockPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}"><Setter TargetName="Head" Property="Visibility" Value="Collapsed"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="c:AvoMetricTile">
        <Setter Property="Background" Value="{StaticResource AvoCardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AvoLine}"/>
        <Setter Property="Foreground" Value="{StaticResource AvoText}"/>
        <Setter Property="Padding" Value="14,10,14,10"/>
        <Setter Property="ValueBrush" Value="{StaticResource AvoText}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:AvoMetricTile">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource AvoRadius}" Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{TemplateBinding Label}" Style="{StaticResource AvoLabel}" TextTrimming="CharacterEllipsis"/>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{TemplateBinding Value}" Style="{StaticResource AvoMetricValue}" FontSize="{TemplateBinding ValueSize}" Foreground="{TemplateBinding ValueBrush}"/>
                                <TextBlock Text="{TemplateBinding Unit}" Margin="5,0,0,4" VerticalAlignment="Bottom" Foreground="{StaticResource AvoTextDim}" FontSize="13"/>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="{TemplateBinding Caption}" Style="{StaticResource AvoCaption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <ContentPresenter Margin="0,4,0,0"/>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="c:AvoStatusIndicator">
        <Setter Property="Foreground" Value="{StaticResource AvoText}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:AvoStatusIndicator">
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Ellipse x:Name="Dot" Width="9" Height="9" Fill="{StaticResource AvoUnknown}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Margin="9,0,8,0" Text="{TemplateBinding Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="Det" Grid.Column="2" Text="{TemplateBinding Detail}" Foreground="{StaticResource AvoUnknown}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="State" Value="Ok"><Setter TargetName="Dot" Property="Fill" Value="{StaticResource AvoOk}"/><Setter TargetName="Det" Property="Foreground" Value="{StaticResource AvoOk}"/></Trigger>
                        <Trigger Property="State" Value="Warning"><Setter TargetName="Dot" Property="Fill" Value="{StaticResource AvoWarn}"/><Setter TargetName="Det" Property="Foreground" Value="{StaticResource AvoWarn}"/></Trigger>
                        <Trigger Property="State" Value="Error"><Setter TargetName="Dot" Property="Fill" Value="{StaticResource AvoBad}"/><Setter TargetName="Det" Property="Foreground" Value="{StaticResource AvoBad}"/></Trigger>
                        <Trigger Property="State" Value="Info"><Setter TargetName="Dot" Property="Fill" Value="{StaticResource AvoBlue}"/><Setter TargetName="Det" Property="Foreground" Value="{StaticResource AvoBlue}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="c:AvoChartPanel">
        <Setter Property="Background" Value="{StaticResource AvoCardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AvoLine}"/>
        <Setter Property="Foreground" Value="{StaticResource AvoText}"/>
        <Setter Property="Padding" Value="12,8,12,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:AvoChartPanel">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource AvoRadius}">
                        <DockPanel Margin="{TemplateBinding Padding}">
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ContentPresenter ContentSource="Header" TextElement.FontWeight="SemiBold" TextElement.FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{TemplateBinding Readout}" Margin="14,0" Foreground="{StaticResource AvoCyan}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <ContentPresenter Grid.Column="2" Content="{TemplateBinding Legend}" VerticalAlignment="Center"/>
                            </Grid>
                            <ContentPresenter/>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="c:AvoMapToolbar">
        <Setter Property="ItemsPanel">
            <Setter.Value><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:AvoMapToolbar">
                    <Border Background="#E6101014" BorderBrush="{StaticResource AvoLine}" BorderThickness="1" CornerRadius="{StaticResource AvoRadius}" Padding="3">
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="c:AvoLegendItem">
        <Setter Property="Margin" Value="10,0,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:AvoLegendItem">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="14" Height="3" Background="{TemplateBinding Swatch}" VerticalAlignment="Center" CornerRadius="1.5"/>
                        <TextBlock Text="{TemplateBinding Text}" Margin="6,0,0,0" Foreground="{StaticResource AvoTextDim}" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="c:AvoKeyValue">
        <Setter Property="Margin" Value="0,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:AvoKeyValue">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{TemplateBinding KeyText}" Foreground="{StaticResource AvoTextDim}" FontSize="12" VerticalAlignment="Top" Margin="0,1,0,0"/>
                        <TextBlock Grid.Column="1" Text="{TemplateBinding ValueText}" Style="{StaticResource AvoValue}" Margin="12,0,0,0" VerticalAlignment="Top" TextAlignment="Right" TextWrapping="Wrap"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
