<Window x:Class="Avo.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Avo.Windows.Views"
        xmlns:vm="clr-namespace:Avo.Windows.ViewModels"
        Title="AVO Performance Horse — Windows Advanced Analysis V2 PRO"
        Width="1600" Height="960" MinWidth="1280" MinHeight="720" WindowStartupLocation="CenterScreen"
        Icon="Assets/AVO.ico" Style="{StaticResource AvoWindow}" Language="es-ES"
        Background="{StaticResource AvoBg}" Foreground="{StaticResource AvoText}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- ============================== header -->
        <Border Background="{StaticResource AvoHeaderBrush}" BorderBrush="{StaticResource AvoLine}" BorderThickness="0,0,0,1">
            <Grid x:Name="HeaderGrid" Margin="16,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/avo_logo_128.png" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="AVO" FontFamily="{StaticResource AvoDisplayFont}" FontSize="32" FontWeight="Light" Foreground="{StaticResource AvoSilver}" Margin="10,0,0,2" VerticalAlignment="Center"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="PERFORMANCE HORSE" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource AvoText}"/>
                        <TextBlock FontSize="11" Foreground="{StaticResource AvoTextDim}">
                            <Run Text="Windows · Advanced Analysis"/><Run Text=" V2 PRO" Foreground="{StaticResource AvoRed}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>
                    <Border Width="1" Background="{StaticResource AvoLine}" Margin="22,14"/>
                </StackPanel>
                <!-- session sub-navigation (analysis area) -->
                <StackPanel x:Name="HeaderTabs" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="4,0,0,0">
                    <RadioButton Style="{StaticResource AvoTabButton}" Content="Análisis" Tag="{StaticResource IconAnalysis}" IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Analysis}"/>
                    <RadioButton Style="{StaticResource AvoTabButton}" Content="Mapa" Tag="{StaticResource IconMap}" IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Map}"/>
                    <RadioButton Style="{StaticResource AvoTabButton}" Content="Gráficas" Tag="{StaticResource IconCharts}" IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Charts}"/>
                    <RadioButton Style="{StaticResource AvoTabButton}" Content="Biomecánica" Tag="{StaticResource IconBiomech}" IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Biomech}"/>
                    <RadioButton Style="{StaticResource AvoTabButton}" Content="Tramos" Tag="{StaticResource IconSegments}" IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Segments}"/>
                    <RadioButton Style="{StaticResource AvoTabButton}" Content="Comparar" Tag="{StaticResource IconCompare}" IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Compare}"/>
                    <RadioButton Style="{StaticResource AvoTabButton}" Content="Mareas" Tag="{StaticResource IconTides}" IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Tides}"/>
                    <RadioButton Style="{StaticResource AvoTabButton}" Content="Informes" Tag="{StaticResource IconReports}" IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Reports}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox Width="300" ItemsSource="{Binding SessionsView}" SelectedItem="{Binding Selected}" ToolTip="Entrenamiento activo">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DateTimeText}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Horse, StringFormat=' · {0}'}" Foreground="{StaticResource AvoTextDim}"/>
                                    <TextBlock Text="{Binding DistanceText, StringFormat=' · {0}'}" Foreground="{StaticResource AvoTextDim}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Style="{StaticResource AvoPrimaryButton}" Margin="10,0,0,0" Command="{Binding ImportCommand}" ToolTip="Abrir entrenamiento .avo / .avr">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconOpen}" Stroke="White" Style="{StaticResource AvoIcon}" Width="15" Height="15"/>
                            <TextBlock Text="Abrir" Margin="7,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================== body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource AvoSurface}" BorderBrush="{StaticResource AvoLine}" BorderThickness="0,0,1,0">
                <DockPanel Margin="0,12,0,10">
                    <StackPanel DockPanel.Dock="Bottom" Margin="16,0">
                        <TextBlock Text="{Binding EngineInfo}" Style="{StaticResource AvoCaption}" TextWrapping="Wrap"/>
                        <TextBlock Text="Formato AVO-TRAINING-1 · AVORAW1" Style="{StaticResource AvoCaption}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <RadioButton Style="{StaticResource AvoNavItem}" Content="Inicio" Tag="{StaticResource IconHome}" IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Home}"/>
                        <RadioButton Style="{StaticResource AvoNavItem}" Content="Análisis" Tag="{StaticResource IconAnalysis}" IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Analysis}"/>
                        <RadioButton Style="{StaticResource AvoNavItem}" Content="Mapa" Tag="{StaticResource IconMap}" IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Map}"/>
                        <RadioButton Style="{StaticResource AvoNavItem}" Content="Gráficas" Tag="{StaticResource IconCharts}" IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Charts}"/>
                        <RadioButton Style="{StaticResource AvoNavItem}" Content="Tramos" Tag="{StaticResource IconSegments}" IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Segments}"/>
                        <RadioButton Style="{StaticResource AvoNavItem}" Content="Biomecánica" Tag="{StaticResource IconBiomech}" IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Biomech}"/>
                        <RadioButton Style="{StaticResource AvoNavItem}" Content="Comparar" Tag="{StaticResource IconCompare}" IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Compare}"/>
                        <RadioButton Style="{StaticResource AvoNavItem}" Content="Mareas y entorno" Tag="{StaticResource IconTides}" IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Tides}"/>
                        <RadioButton Style="{StaticResource AvoNavItem}" Content="Informes" Tag="{StaticResource IconReports}" IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Reports}"/>
                        <Separator Margin="18,8"/>
                        <RadioButton Style="{StaticResource AvoNavItem}" Content="Servidor AVO" Tag="{StaticResource IconServer}" IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Server}"/>
                        <RadioButton Style="{StaticResource AvoNavItem}" Content="Motor AVO" Tag="{StaticResource IconEngine}" IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Engine}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1">
                <v:HomeView Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Home}"/>
                <v:AnalysisView Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Analysis}"/>
                <v:MapView Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Map}"/>
                <v:ChartsView Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Charts}"/>
                <v:SegmentsView Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Segments}"/>
                <v:BiomechView Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Biomech}"/>
                <v:CompareView Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Compare}"/>
                <v:TidesView Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Tides}"/>
                <v:ReportsView Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Reports}"/>
                <v:ServerView Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Server}"/>
                <v:EngineView Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Engine}"/>
            </Grid>
        </Grid>

        <!-- ============================== status bar -->
        <Border Grid.Row="2" Background="{StaticResource AvoSurface}" BorderBrush="{StaticResource AvoLine}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressBar Width="80" Height="4" IsIndeterminate="True" Margin="0,0,10,0" Visibility="{Binding Busy, Converter={StaticResource BoolVis}}"/>
                <TextBlock Grid.Column="1" Text="{Binding Status}" Style="{StaticResource AvoCaption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Style="{StaticResource AvoCaption}" VerticalAlignment="Center">
                    <Run Text="TELEMETRÍA ORIGINAL INTACTA · GNSS = CHALECO DEL JINETE · IMU = CINCHA · Europe/Madrid · v"/><Run Text="{Binding Source={x:Static vm:MainViewModel.Version}, Mode=OneWay}"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
