	<!-- Join the watch's own Wi-Fi network (AVO_CHEST_XXXX) to download trainings, as Android 2.3-wifi does -->
	<key>com.apple.developer.networking.HotspotConfiguration</key>
	<true/>
</dict>
</plist>
